[Desktop Entry]
Name=Ledger (debug)
Comment=Provider usage panel applet for COSMIC (debug build, demo mode)
Type=Application
Icon=io.github.mrn3ff.cosmic-applet-ledger
Exec=env LEDGER_DEMO=1 cosmic-applet-ledger-debug
Terminal=false
StartupNotify=true
Categories=Utility;X-COSMIC;
Keywords=COSMIC;Usage;Quota;Debug;
NoDisplay=true
X-CosmicApplet=true
X-CosmicHoverPopup=Auto
MimeType=
